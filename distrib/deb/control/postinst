# Register this sibling in the kura-core install-order registry so
# gen_config_ini.sh loads it in install order. Idempotent: only appends if
# this sibling's directory name is not already listed (handles upgrade and
# dpkg --install of an already-installed package).

SIBLING_NAME="cloud"
REGISTRY="/opt/eclipse/kura/framework/sibling-install-order"
KURA_PROPERTIES="/opt/eclipse/kura/framework/kura.properties"

if [ -f "${REGISTRY}" ]; then
    if ! grep -qFx "${SIBLING_NAME}" "${REGISTRY}"; then
        echo "${SIBLING_NAME}" >> "${REGISTRY}"
    fi
else
    # Registry not present: kura-core may be too old or being installed in
    # parallel. Create it so we can still record our name; kura-core's
    # postinst will adopt it (idempotent file creation there too).
    mkdir -p /opt/eclipse/kura/framework 2>/dev/null || true
    echo "${SIBLING_NAME}" > "${REGISTRY}"
    chown kurad:kurad "${REGISTRY}" 2>/dev/null || true
    chmod 664 "${REGISTRY}" 2>/dev/null || true
fi

# Enable Cloud Connections UI tab: flip kura.have.cloud.connection to true.
# kura-core ships this property as false by default so the tab is hidden
# when kura-cloud is not installed.
if [ -f "${KURA_PROPERTIES}" ]; then
    sed -i "s|^#*kura.have.cloud.connection=.*|kura.have.cloud.connection=true|" "${KURA_PROPERTIES}"
fi

exit 0
